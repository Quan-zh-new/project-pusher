# Copy this file to .env, then fill in only the integrations you use.
# Never commit .env: it may contain your API key and local proxy settings.

# Required for real AI conversations. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Optional. Leave empty to use the app default model.
# OPENROUTER_MODEL="deepseek/deepseek-v4-pro-0813"

# Optional. Use a compatible endpoint only when your organization provides one.
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Optional. If your network needs an HTTP/Mixed proxy, set its HTTP port.
# HTTPS_PROXY="http://127.0.0.1:7890"
# HTTP_PROXY="http://127.0.0.1:7890"
# NO_PROXY="localhost,127.0.0.1"
